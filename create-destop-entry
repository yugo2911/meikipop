#!/bin/bash

# Get absolute path of the directory containing this script
APP_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ICON_PATH="$APP_ROOT/src/resources/icon.ico"
TARGET="$HOME/.local/share/applications/meikipop.desktop"

# Use python3 to ensure it finds the correct environment
PYTHON_EXEC=$(which python3)

cat <<EOF > "$TARGET"
[Desktop Entry]
Name=Meikipop
Comment=OCR Pop-up Dictionary
Exec=$PYTHON_EXEC -m src.main
Path=$APP_ROOT
Icon=$ICON_PATH
Terminal=false
Type=Application
Categories=Utility;
StartupWMClass=meikipop
EOF

chmod +x "$TARGET"
update-desktop-database ~/.local/share/applications/
echo "Created desktop entry at: $TARGET"